(// Lines 283-315: The TICK Reducer Action) Tj
T* (case 'TICK': {) Tj
T* (  // 1. Advance the mathematical model for all 12 NER zones) Tj
T* (  const zones = state.zones.map\(\(z\) => stepZone\(z, tick\)\)) Tj
T* (  // 2. Automatically check if road corridors are cut off by landslides) Tj
T* (  const roads = state.roads.map\(\(r\) => \({ ...r, status: roadStatusFromZones\(r.zoneIds, zones\) }\)\)) Tj
T* (  // 3. Trigger automatic alert records if a zone jumps to High/Critical) Tj
T* (  const freshAlerts = seedAlerts\(zones\)) Tj
T* (  return { ...state, zones, roads, tick: state.tick + 1 }) Tj
T* (}) Tj
T* () Tj
T* (// Lines 337-341: Simulation Heartbeat) Tj
T* (useEffect\(\(\) => {) Tj
T* (  if \(!state.live\) return) Tj
T* (  const id = window.setInterval\(\(\) => dispatch\({ type: 'TICK' }\), 2500\) // 2.5s loop) Tj
T* (  return \(\) => window.clearInterval\(id\)) Tj
T* (}, [state.live]\)) Tj
