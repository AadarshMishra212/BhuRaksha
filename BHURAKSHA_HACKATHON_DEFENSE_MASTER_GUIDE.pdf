(// Lines 8-13: Severity Threshold Classification) Tj
T* (export function severityOf\(score: number\): Severity {) Tj
T* (  if \(score >= 76\) return 'Critical'  // Triggers immediate evacuation alert) Tj
T* (  if \(score >= 56\) return 'High'      // Yellow warning, preposition SDRF) Tj
T* (  if \(score >= 36\) return 'Moderate'  // Watch condition) Tj
T* (  return 'Low'                        // Normal monitoring) Tj
T* (}) Tj
T* () Tj
T* (// Lines 41-96: Multi-Parameter Weighted Scoring Algorithm & SHAP Explainability) Tj
T* (export function scoreZone\(input: { ... }\): { score: number; explain: FeatureContribution[] } {) Tj
T* (  const parts: FeatureContribution[] = [) Tj
T* (    { feature: '24h rainfall \(IMD / AWS\)',     weight: 0.28, contribution: 0.28 * nRain\(input.rainfall24h\) },) Tj
T* (    { feature: 'Soil moisture',                weight: 0.18, contribution: 0.18 * nSoil\(input.soilMoisture\) },) Tj
T* (    { feature: 'Slope angle',                  weight: 0.14, contribution: 0.14 * nSlope\(input.slopeDeg\) },) Tj
T* (    { feature: 'Short-burst intensity',        weight: 0.12, contribution: 0.12 *) Tj
T* (nIntensity\(input.rainfallIntensity\) },) Tj
T* (    { feature: 'Historical landslide density', weight: 0.10, contribution: 0.10 *) Tj
T* (nHist\(input.historicalEvents\) },) Tj
T* (    { feature: 'GNSS / InSAR displacement',    weight: 0.10, contribution: 0.10 * nDisp\(input.displacementMm\)) Tj
T* (},) Tj
T* (    { feature: 'Vegetation / NDVI stress',     weight: 0.08, contribution: 0.08 * clamp\(input.ndviStress, 0,) Tj
T* (1\) },) Tj
T* (  ]) Tj
T* (  const raw = parts.reduce\(\(s, p\) => s + p.contribution, 0\)) Tj
T* (  return { score: clamp\(raw * 100, 4, 98\), explain: parts }) Tj
T* (}) Tj
